{
  "name": "@run-agents/it",
  "version": "0.2.0",
  "description": "An IT-manager agent harness: humans set it up, other agents request keys/access; it provisions via API or signs up via browser on behalf of the org.",
  "type": "module",
  "bin": {
    "it": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "PROGRESS.md"
  ],
  "scripts": {
    "start": "node src/index.ts",
    "smoke": "node scripts/smoke.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "agent",
    "agents",
    "mcp",
    "it-manager",
    "provisioning",
    "secrets",
    "vault",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0"
  },
  "optionalDependencies": {
    "playwright": "^1.49.0"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.24.2"
  }
}
